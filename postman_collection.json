{
  "info": {
    "name": "TechMind — QA Test Suite v0.4",
    "_postman_id": "techmind-g9-latam-team37",
    "description": "Colección de tests para el sistema TechMind.\nEquipo: G9 LATAM Team 37\n\nSetup:\n1. Importar esta colección en Postman\n2. Crear environment con: BASE_URL=http://localhost:8080 y DS_URL=http://localhost:8000\n3. Correr en orden o usar el Runner para toda la suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:8080" },
    { "key": "DS_URL",   "value": "http://localhost:8000"  }
  ],
  "item": [
    {
      "name": "🔍 Health Checks",
      "item": [
        {
          "name": "HC-001 · FastAPI Health",
          "request": {
            "method": "GET",
            "url": "{{DS_URL}}/health"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('status ok', () => pm.expect(body.status).to.eql('ok'));",
              "pm.test('model_loaded true', () => pm.expect(body.model_loaded).to.be.true);",
              "pm.test('version present', () => pm.expect(body.version).to.be.a('string'));"
            ]}
          }]
        },
        {
          "name": "HC-002 · FastAPI Categorías",
          "request": {
            "method": "GET",
            "url": "{{DS_URL}}/categorias"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('8 categorías', () => pm.expect(body.categorias).to.have.lengthOf(8));",
              "const expected = ['Backend','Bases de Datos','Cloud','Data Science','DevOps','Frontend','Mobile','Seguridad'];",
              "expected.forEach(c => pm.test('Categoría ' + c, () => pm.expect(body.categorias).to.include(c)));"
            ]}
          }]
        }
      ]
    },
    {
      "name": "🟢 Happy Path — Las 8 categorías",
      "item": [
        {
          "name": "TC-001 · Backend (Spring Boot + Java)",
          "request": {
            "method": "POST",
            "url": "{{DS_URL}}/predecir",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Introducción a Spring Boot\",\n  \"texto\": \"Conceptos básicos para la creación de APIs REST con Java y Spring Boot. Incluye configuración de dependencias, controladores y manejo de excepciones.\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('categoria == Backend', () => pm.expect(body.categoria).to.eql('Backend'));",
              "pm.test('probabilidad > 0', () => pm.expect(body.probabilidad).to.be.above(0));",
              "pm.test('probabilidad <= 1', () => pm.expect(body.probabilidad).to.be.at.most(1));",
              "pm.test('informaciones_adicionales es array', () => pm.expect(body.informaciones_adicionales).to.be.an('array'));",
              "pm.test('Tiempo < 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
            ]}
          }]
        },
        {
          "name": "TC-002 · Data Science (ML + TF-IDF)",
