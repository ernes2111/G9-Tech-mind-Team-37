          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('categoria == Data Science', () => pm.expect(body.categoria).to.eql('Data Science'));",
              "pm.test('probabilidad en rango 0-1', () => { pm.expect(body.probabilidad).to.be.above(0); pm.expect(body.probabilidad).to.be.at.most(1); });"
