    {
      "name": "📊 Validación de formato de respuesta",
      "item": [
        {
          "name": "FMT-001 · Validar estructura completa del JSON",
          "request": {
            "method": "POST",
            "url": "{{DS_URL}}/predecir",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Kubernetes y orquestación de contenedores\",\n  \"texto\": \"Gestión de pods, deployments y services en Kubernetes. Configuración de recursos, escalado automático y monitoreo con Prometheus.\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const categorias = ['Backend','Bases de Datos','Cloud','Data Science','DevOps','Frontend','Mobile','Seguridad'];",
              "pm.test('categoria es string válido', () => pm.expect(categorias).to.include(body.categoria));",
              "pm.test('probabilidad es número 0-1', () => {",
              "  pm.expect(body.probabilidad).to.be.a('number');",
              "  pm.expect(body.probabilidad).to.be.above(0);",
              "  pm.expect(body.probabilidad).to.be.at.most(1);",
              "});",
              "pm.test('informaciones_adicionales es array', () => pm.expect(body.informaciones_adicionales).to.be.an('array'));",
              "pm.test('informaciones_adicionales máx 5 elementos', () => pm.expect(body.informaciones_adicionales.length).to.be.at.most(5));",
              "pm.test('Content-Type es application/json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Tiempo respuesta < 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
            ]}
          }]
        }
